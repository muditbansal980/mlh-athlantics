REDIS_URL=redis://localhost:6379
# Server the worker posts finished analyses to
BACKEND_URL=http://localhost:5000
POSE_SERVICE_URL=http://localhost:8000
# Must be readable by pose-service too (same machine locally, shared volume in Docker)
SHARED_DIR=/tmp/athlantics/videos
# Must match INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=change-me
