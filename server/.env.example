PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlh-athlantics
JWT_SECRET=hackathon-dev-secret-key-change-in-production

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Optional: deployed backend URL to ping every 10 minutes (keeps free hosts awake)
# HEALTH_PING_URL=

# Shared secret the worker must send (x-internal-key) to /api/internal routes
INTERNAL_API_KEY=change-me

# Gemini LLM used to write activity reports (key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the main model is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Redis job queue (video analysis)
REDIS_URL=redis://localhost:6379

# Cloudinary (activity video storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
